#!/command/with-contenv sh
set -eu

if [ -z "${OBSIDIAN_VAULT_PATH:-}" ]; then
    echo "[obsidian-sync] Disabled: OBSIDIAN_VAULT_PATH is unset"
    exit 0
fi

# Require persistent storage, including after resolving .. and symlinks.
case "$OBSIDIAN_VAULT_PATH" in
    /data/*) ;;
    *)
        echo "[obsidian-sync] OBSIDIAN_VAULT_PATH must be an absolute path under /data" >&2
        exit 1
        ;;
esac
resolved_path=$(realpath -m -- "$OBSIDIAN_VAULT_PATH")
case "$resolved_path" in
    /data/*) ;;
    *)
        echo "[obsidian-sync] OBSIDIAN_VAULT_PATH resolves outside /data" >&2
        exit 1
        ;;
esac

# Preserve the container's HOME and XDG_CONFIG_HOME. Obsidian resolves its
# existing state itself (by default /data/.config/obsidian-headless).
# Exec after dropping privileges so s6 signals reach ob directly.
if [ "$(id -u)" = 0 ]; then
    set -- s6-setuidgid hermes
else
    set --
fi
echo "[obsidian-sync] Starting continuous sync: $OBSIDIAN_VAULT_PATH"
exec "$@" ob sync --continuous --path "$OBSIDIAN_VAULT_PATH"
